# AI step resolver: heuristic (no key, free) | gemini (free tier) | groq (free tier) | anthropic (paid)
FLOWGUARD_RESOLVER=heuristic
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
PUBLIC_APP_URL=http://localhost:3000
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@flowguard.example
