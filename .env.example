# Copy to .env (repo root). Everything is optional: with nothing set, the web app shows
# demo data and the worker uses the free zero-key heuristic resolver.

# ---- Web (apps/web) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Worker (apps/worker) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
PUBLIC_APP_URL=http://localhost:3000

# AI step resolver: heuristic (no key, free) | gemini (free tier) | groq (free tier) | anthropic (paid)
# Leave empty to auto-select: gemini when GEMINI_API_KEY is set, otherwise heuristic.
FLOWGUARD_RESOLVER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=

# Alerts: fallback Slack incoming webhook when a workspace has none.
SLACK_WEBHOOK_URL=

# Scale-up path only (BullMQ). Upstash Redis free tier works.
REDIS_URL=redis://localhost:6379
