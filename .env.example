# ---- Web (apps/web) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ---- Worker (apps/worker) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
REDIS_URL=redis://localhost:6379
ANTHROPIC_API_KEY=
# Model used by the AI step resolver (defaults to claude-opus-5-5 at low effort).
# claude-haiku-5-5 is ~40x cheaper per token if you want to trade accuracy for cost.
FLOWGUARD_RESOLVER_MODEL=claude-opus-5-5
PUBLIC_APP_URL=http://localhost:3000
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@flowguard.example
