{
  "name": "flowguard",
  "private": true,
  "description": "Autonomous QA & critical-flow monitoring — Uptime Robot for user journeys.",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev -w @flowguard/web",
    "dev:worker": "npm run dev -w @flowguard/worker",
    "build": "npm run build -w @flowguard/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "prototype": "npm run prototype -w @flowguard/worker --",
    "scan": "npm run scan -w @flowguard/worker --"
  },
  "engines": { "node": ">=20" }
}
