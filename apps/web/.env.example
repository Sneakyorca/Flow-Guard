# Optional. The app builds and renders demo data without these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: used to sign short-lived replay video URLs for public share links.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only, optional: lets the "Run" button start a GitHub Actions run right away.
# Fine-grained GitHub token for this repo with "Actions: Read and write" (free).
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=Sneakyorca/Flow-Guard
